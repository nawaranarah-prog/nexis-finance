{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nexis-finance-api.vercel.app/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://nexis-finance-api.vercel.app/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://nexis-finance-api.vercel.app/openapi.json"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://nexis-finance-api.vercel.app/api/seo/sitemap.xml"
    },
    {
      "source": "/pulse/d/:path*",
      "missing": [
        {
          "type": "query",
          "key": "spa"
        }
      ],
      "destination": "https://nexis-finance-api.vercel.app/api/seo/render/pulse/d/:path*"
    },
    {
      "source": "/markets/:symbol",
      "missing": [{ "type": "query", "key": "spa" }],
      "destination": "https://nexis-finance-api.vercel.app/api/seo/render/markets/:symbol"
    },
    {
      "source": "/finstagram/p/:id",
      "missing": [{ "type": "query", "key": "spa" }],
      "destination": "https://nexis-finance-api.vercel.app/api/seo/render/finstagram/p/:id"
    },
    {
      "source": "/:name(pro|terms|privacy|disclaimer|world-graph|time-machine|devils-advocate|my-research)",
      "missing": [{ "type": "query", "key": "spa" }],
      "destination": "https://nexis-finance-api.vercel.app/api/seo/render/page/:name"
    },
    {
      "source": "/((?!assets/|favicon.svg|robots.txt|og-image.png|apple-touch-icon.png|google[0-9a-f]+\\.html).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/(my-nexis|my-nexis/.*|notifications|settings|moderation|portfolio)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
