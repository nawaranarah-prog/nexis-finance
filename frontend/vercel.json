{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://nexis-finance-api.vercel.app/api/:path*" },
    { "source": "/docs", "destination": "https://nexis-finance-api.vercel.app/docs" },
    { "source": "/openapi.json", "destination": "https://nexis-finance-api.vercel.app/openapi.json" },
    { "source": "/sitemap.xml", "destination": "https://nexis-finance-api.vercel.app/api/seo/sitemap.xml" },
    { "source": "/((?!assets/|favicon.svg|robots.txt|og-image.png|apple-touch-icon.png|google[0-9a-f]+\\.html).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
