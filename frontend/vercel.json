{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://nexis-finance-api-nawar.onrender.com/api/:path*" },
    { "source": "/docs", "destination": "https://nexis-finance-api-nawar.onrender.com/docs" },
    { "source": "/openapi.json", "destination": "https://nexis-finance-api-nawar.onrender.com/openapi.json" },
    { "source": "/((?!assets/|favicon.svg).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
