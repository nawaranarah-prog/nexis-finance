# Copy to backend/.env (or export in your shell). Never commit a real .env file.

# --- Backend -----------------------------------------------------------
NEXIS_ENV=development
NEXIS_LOG_LEVEL=INFO
# JSON logs (true) or human-readable logs (false)
NEXIS_LOG_JSON=false

# SQLite (default, zero-setup) or PostgreSQL:
#   NEXIS_DATABASE_URL=postgresql+psycopg://nexis:nexis@localhost:5432/nexis
NEXIS_DATABASE_URL=sqlite:///../data/nexis.db

# Comma-separated list of allowed browser origins for CORS
NEXIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Directory for generated research reports (PDF)
NEXIS_REPORTS_DIR=../data/reports

# Public market data provider (Yahoo Finance chart endpoint, unofficial, no key).
# Disabled by default so the application runs fully offline in synthetic mode.
NEXIS_PUBLIC_PROVIDER_ENABLED=false
NEXIS_PUBLIC_PROVIDER_TIMEOUT_SECONDS=15

# Maximum CSV upload size in megabytes
NEXIS_MAX_UPLOAD_MB=20

# Annual risk-free rate used as the default for Sharpe/Sortino (decimal)
NEXIS_RISK_FREE_RATE=0.02

# --- Frontend ----------------------------------------------------------
# Put in frontend/.env.local if the API is not on the Vite dev proxy
# VITE_API_BASE_URL=http://localhost:8000
