# Copy to backend/.env (or export in your shell). Never commit a real .env file.

# --- Backend -----------------------------------------------------------
NEXIS_ENV=development
NEXIS_LOG_LEVEL=INFO
# JSON logs (true) or human-readable logs (false)
NEXIS_LOG_JSON=false

# SQLite (default, zero-setup) or PostgreSQL:
#   NEXIS_DATABASE_URL=postgresql+psycopg://nexis:nexis@localhost:5432/nexis
NEXIS_DATABASE_URL=sqlite:///../data/nexis.db

# Comma-separated list of allowed browser origins for CORS
NEXIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Directory for generated research reports (PDF)
NEXIS_REPORTS_DIR=../data/reports

# Public market data provider (Yahoo Finance chart endpoint, unofficial, no key).
# Disabled by default so the application runs fully offline in synthetic mode.
NEXIS_PUBLIC_PROVIDER_ENABLED=false
NEXIS_PUBLIC_PROVIDER_TIMEOUT_SECONDS=15

# Maximum CSV upload size in megabytes
NEXIS_MAX_UPLOAD_MB=20

# Annual risk-free rate used as the default for Sharpe/Sortino (decimal)
NEXIS_RISK_FREE_RATE=0.02

# Keyless public sources (US Treasury, World Bank, SEC EDGAR) and keyed ones (FRED, Alpaca)
NEXIS_EXTERNAL_DATA_ENABLED=true
# SEC fair-access policy: identify yourself with an app name and a contact email
NEXIS_SEC_USER_AGENT="YourApp you@example.com"

# Fernet key for credentials at rest (required outside development):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEXIS_SECRET_KEY=

# Run jobs inside the request instead of a thread pool (defaults to true on Vercel)
# NEXIS_JOBS_INLINE=false
# Shared public deployment: refuse to store credentials and warn that imports are visible to everyone
# NEXIS_PUBLIC_INSTANCE=false

# --- Frontend ----------------------------------------------------------
# Put in frontend/.env.local if the API is not on the Vite dev proxy
# VITE_API_BASE_URL=http://localhost:8000

# Public origin of the web app (OAuth redirect URIs)
# NEXIS_PUBLIC_URL=https://your-app.example.com
# Sign in with Google / Apple (each enabled when set)
# NEXIS_GOOGLE_CLIENT_ID=
# NEXIS_GOOGLE_CLIENT_SECRET=
# NEXIS_APPLE_CLIENT_ID=
# NEXIS_APPLE_TEAM_ID=
# NEXIS_APPLE_KEY_ID=
# NEXIS_APPLE_PRIVATE_KEY=
# AI advisor model (Vercel AI Gateway id); or set ANTHROPIC_API_KEY / NEXIS_LLM_API_KEY + NEXIS_LLM_BASE_URL
# NEXIS_LLM_MODEL=anthropic/claude-opus-5.5
